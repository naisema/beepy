# Device home-directory backup — contains a hardcoded API key
# (beepy/chatgpt_client.py, see CLAUDE.md). Never commit.
/beepy/
/beepy.tar.gz

# Independent git checkout of michaelstepner/beepy-buildroot (own history,
# own remote) — not part of this repo.
/beepy-buildroot/

# Build outputs
*.o
*.a
out-*.fb
/host/
/gps-monitor/gps-monitor
/beepy-nav/beepy-nav
/beepy-nav/fbplay
/beepy-nav/tests/test_map
/beepy-nav/tests/test_gpx
/beepy-nav/tests/test_route
/beepy-nav/tests/test_tile
/beepy-nav/tests/test_search
/beepy-nav/tests/test_netfetch
out-*.tiles
out-*.roads

# Generated animation (9+ MB, regenerable via sim.py)
sim-anim.bin

# Generated GPX fixture (1.2 MB, regenerable via gen_oversize.py)
/beepy-nav/tests/gpx/oversize.gpx

# Generated replay rides and their traces (regenerable via mknmea.py; the
# seeds and options live in the Makefile, which is the actual fixture).
# beepy-nav/tests/rides/ is deliberately NOT here: those are RECORDINGS off
# the device (DESIGN.md 7.6) and nothing regenerates them.
/beepy-nav/tests/replay/*.nmea
/beepy-nav/tests/replay/*.tsv
/beepy-nav/tests/replay/*.fb
/beepy-nav/tests/replay/*.log

# OS / tooling noise
.DS_Store
__pycache__/
*.pyc
